# 배포 후 확정된 고정 Production URL. Preview URL은 사용하지 않습니다.
NEXT_PUBLIC_SITE_URL=

# 스토어 출시 후 실제 URL을 입력합니다. 비어 있으면 출시 준비 상태로 표시됩니다.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Android App Links (server-only)
ANDROID_RELEASE_SHA256_CERT_FINGERPRINTS=
# 선택: debug 앱도 연결할 때만 설정
ANDROID_DEBUG_SHA256_CERT_FINGERPRINTS=

# iOS Universal Links (server-only)
APPLE_TEAM_ID=
# 선택: debug 앱도 연결할 때 true
IOS_INCLUDE_DEBUG_APP=false
